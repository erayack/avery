---
import ThemeInit from '../../components/ThemeInit.astro';
import { posts, type Post } from '../../data/posts';
import '../../styles/global.css';

export function getStaticPaths() {
  return posts.map(({ slug, ...post }) => ({ params: { slug }, props: { post } }));
}

const { post } = Astro.props as { post: Omit<Post, 'slug'> };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={post.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{post.title} — Avery Rowan</title>
    <ThemeInit />
  </head>
  <body>
    <a class="skip-link" href="#article">Skip to article</a>

    <header class="post-nav container">
      <a class="post-brand" href="/" aria-label="Back to Avery Rowan home">
        <strong>Avery</strong>
        <span>Designer and Creator</span>
      </a>
      <a class="back-link" href="/">← Back home</a>
      <button class="icon-button theme-toggle post-theme" type="button" aria-label="Use dark mode" aria-pressed="false">
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.4 15.2A8.4 8.4 0 0 1 8.8 3.6 8.5 8.5 0 1 0 20.4 15.2Z"/></svg>
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </header>

    <main class="post-main container" id="article">
      <article>
        <header class="article-header">
          <p class="article-kicker">Design notes · {post.readTime}</p>
          <h1>{post.title}</h1>
          <p class="article-intro">{post.intro}</p>
          <time datetime={post.date}>{post.dateLabel}</time>
        </header>

        <figure class="article-image">
          <img src={post.image} alt={post.imageAlt} />
          <figcaption>{post.caption}</figcaption>
        </figure>

        <div class="article-body">
          {post.sections.map((section) => (
            <section>
              <h2>{section.heading}</h2>
              {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
              {section.quote && <blockquote>{section.quote}</blockquote>}
              {section.items && <ul>{section.items.map((item) => <li>{item}</li>)}</ul>}
            </section>
          ))}
        </div>

        <footer class="article-footer">
          <p>Thanks for reading.</p>
          <a class="button secondary pill" href="/">Return to Avery</a>
        </footer>
      </article>
    </main>

    <script>
      const root = document.documentElement;
      const button = document.querySelector<HTMLButtonElement>('.post-theme');

      function updateThemeButton() {
        const dark = root.dataset.theme === 'dark';
        if (button) {
          button.setAttribute('aria-label', dark ? 'Use light mode' : 'Use dark mode');
          button.setAttribute('aria-pressed', String(dark));
        }
      }

      button?.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        localStorage.setItem('theme', root.dataset.theme);
        updateThemeButton();
      });
      updateThemeButton();
    </script>
  </body>
</html>

<style>
  .post-nav { display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 24px; min-height: 176px; }
  .post-brand { display: inline-flex; flex-direction: column; align-items: flex-start; width: max-content; gap: 3px; }
  .post-brand strong { font-size: 34px; line-height: 40px; font-weight: 600; letter-spacing: -.05em; }
  .post-brand span { color: var(--secondary); font-size: 14px; line-height: 1.4; }
  .back-link { font-size: 14px; font-weight: 600; }
  .back-link:hover { color: var(--accent); }
  .post-main { padding-top: 72px; }
  .article-header { padding-bottom: 64px; }
  .article-kicker { margin: 0 0 20px; color: var(--accent); font-size: 12px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; }
  .article-header h1 { max-width: 580px; margin: 0; font-size: clamp(38px, 6vw, 58px); line-height: 1.08; letter-spacing: -.04em; }
  .article-intro { margin: 28px 0 20px; color: var(--secondary); font-size: 21px; line-height: 1.55; }
  .article-header time { color: var(--tertiary); font-size: 14px; }
  .article-image { margin: 0 0 64px; }
  .article-image img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .article-image figcaption { margin-top: 10px; color: var(--tertiary); font-size: 13px; text-align: center; }
  .article-body h2 { margin: 56px 0 16px; font-size: 26px; line-height: 1.3; }
  .article-body p, .article-body li { color: var(--secondary); }
  .article-body p { margin: 0; }
  .article-body p + p { margin-top: 20px; }
  .article-body ul { padding-left: 24px; }
  .article-body li + li { margin-top: 8px; }
  .article-body blockquote { margin: 48px 0; padding-left: 24px; border-left: 2px solid var(--accent); font-size: 24px; line-height: 1.5; letter-spacing: -.02em; }
  .article-footer { margin-top: 80px; padding: 56px 0 80px; border-top: 1px solid var(--divider); }
  .article-footer p { margin: 0 0 20px; color: var(--secondary); }

  @media (max-width: 767px) {
    .post-nav { grid-template-columns: 1fr auto; min-height: 128px; gap: 16px; }
    .post-brand strong { font-size: 31px; line-height: 36px; }
    .back-link { display: none; }
    .post-main { padding-top: 48px; }
    .article-header { padding-bottom: 48px; }
    .article-header h1 { font-size: 40px; }
    .article-intro { font-size: 19px; }
    .article-image { margin-bottom: 48px; }
    .article-body h2 { margin-top: 44px; }
  }
</style>
