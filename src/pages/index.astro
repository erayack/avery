---
import ThemeInit from '../components/ThemeInit.astro';
import '../styles/global.css';

const navItems = [
  { label: 'Thoughts', href: '#thoughts' },
  { label: 'Works', href: '#works' },
  { label: 'Now', href: '#now' },
  { label: 'Books', href: 'https://example.com/books/' },
  { label: 'Course', href: 'https://example.com/course/' },
];

const projects = [
  {
    name: 'Northstar Studio',
    url: 'northstar.example',
    description: 'Premium themes for writers, bloggers and independent designers.',
    image: 'https://images.unsplash.com/photo-1557683316-973673baf926?auto=format&fit=crop&w=160&q=80',
  },
  {
    name: 'Folioform',
    url: 'folioform.example',
    description: 'A thoughtful portfolio builder for your next opportunity.',
    image: 'https://images.unsplash.com/photo-1557682250-33bd709cbe85?auto=format&fit=crop&w=160&q=80',
  },
  {
    name: 'Atlas Notes',
    url: 'atlasnotes.example',
    description: 'The best visual lessons from across the internet, collected for you.',
    image: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=160&q=80',
  },
];

const studies = [
  {
    title: 'Harmonize the Web Experience',
    company: 'Meridian Mobility',
    image: 'https://images.unsplash.com/photo-1551650975-87deedd944c3?auto=format&fit=crop&w=750&q=85',
    href: '/work/meridian-mobility/',
  },
  {
    title: 'Perfecting the location picker',
    company: 'Parcel Labs',
    image: 'https://images.unsplash.com/photo-1558655146-9f40138edfeb?auto=format&fit=crop&w=750&q=85',
  },
  {
    title: 'Premium eCommerce Website',
    company: 'Maison Market',
    image: 'https://images.unsplash.com/photo-1523726491678-bf852e717f6a?auto=format&fit=crop&w=750&q=85',
  },
  {
    title: 'Internal time tracking',
    company: 'Tempo Works',
    image: 'https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=750&q=85',
  },
];

const testimonials = [
  {
    quote: 'Avery’s design gave my portfolio a competitive edge. The process was thoughtful, collaborative, and refreshingly clear.',
    name: 'Noah Williams',
    role: 'Digital Artist',
    image: 'https://images.unsplash.com/photo-1583195763986-0231686dcd43?auto=format&fit=crop&w=160&q=80',
  },
  {
    quote: 'The new direction transformed my photography site. It pairs a beautiful visual system with an effortless reading experience.',
    name: 'Eli Bennett',
    role: 'Professional Photographer',
    image: 'https://images.unsplash.com/photo-1512359573855-953710d3f7a8?auto=format&fit=crop&w=160&q=80',
  },
  {
    quote: 'Avery brought elegance and focus to my food journal. Every detail feels deliberate without getting in the way of the stories.',
    name: 'Maya Chen',
    role: 'Food Blogger',
    image: 'https://images.unsplash.com/photo-1514161955277-4ea47eef2ff9?auto=format&fit=crop&w=160&q=80',
  },
  {
    quote: 'Northstar Studio transformed my journal into a calm, intuitive home for my work. The result feels entirely my own.',
    name: 'Lena Hart',
    role: 'Blogger',
    image: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=160&q=80',
  },
];

const experiences = [
  ['Founder', 'Northstar Studio', '2021 — Present'],
  ['Co-founder', 'Common Room', '2020 — 2021'],
  ['Product Designer', 'Social Labs', '2018 — 2020'],
  ['Product Designer', 'Relay', '2015 — 2018'],
];

const Arrow = `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Avery Rowan is a designer and creator crafting thoughtful digital experiences." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Avery Rowan — Designer and Creator</title>
    <ThemeInit />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <div class="header-main">
          <a class="brand" href="/" aria-label="Avery Rowan home">
            <strong class="brand-name">Avery</strong>
            <span>Designer and Creator</span>
          </a>

          <nav class="desktop-nav" aria-label="Primary navigation">
            {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
            <button class="icon-button more-button" type="button" aria-label="Show more navigation" aria-expanded="false" aria-controls="more-nav">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg>
            </button>
            <div class="more-nav" id="more-nav" hidden>
              <a href="#testimonials">Testimonials</a>
              <a href="#experience">Timeline</a>
              <a href="#main">About</a>
            </div>
            <button class="icon-button theme-toggle" type="button" aria-label="Use dark mode" aria-pressed="false">
              <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.4 15.2A8.4 8.4 0 0 1 8.8 3.6 8.5 8.5 0 1 0 20.4 15.2Z"/></svg>
              <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            </button>
          </nav>

          <div class="mobile-actions">
            <button class="icon-button menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav">
              <span></span><span></span>
            </button>
          </div>

          <img class="profile-image" src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=320&q=85" alt="Portrait of the site creator" />
        </div>

        <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation" hidden>
          {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href="#testimonials">Testimonials</a>
          <a href="#experience">Timeline</a>
          <a href="#footer">About</a>
          <button class="theme-toggle mobile-theme" type="button" aria-pressed="false">Use dark mode</button>
        </nav>
      </div>
      <div class="container"><div class="wave-divider"></div></div>
    </header>

    <main id="main">
      <section class="container hero" aria-labelledby="hero-title">
        <h1 id="hero-title">I’m Avery — a designer and creator.</h1>
        <p>Hi, my name is Avery. I design and build what I imagine. I craft thoughtful solutions to everyday problems and make the things we already enjoy even better.</p>

        <div class="newsletter">
          <p>Subscribe to my monthly newsletter</p>
          <form id="newsletter-form">
            <label class="sr-only" for="newsletter-email">Email address</label>
            <input id="newsletter-email" name="email" type="email" placeholder="Enter your email" autocomplete="email" required />
            <button class="button primary" type="submit">Subscribe</button>
          </form>
          <p class="form-status" role="status" aria-live="polite"></p>
        </div>
      </section>

      <section class="section" aria-labelledby="featured-title">
        <div class="container">
          <h2 class="section-title" id="featured-title">Featured on</h2>
          <div class="logo-list" aria-label="Featured publications">
            <span>MTV</span><span>Forbes</span><span>CNBC</span><span class="nyt">The New York Times</span>
          </div>
        </div>
      </section>

      <section class="section" id="now" aria-labelledby="creating-title">
        <div class="container">
          <h2 class="section-title" id="creating-title">Creating</h2>
          <div class="projects-grid">
            {projects.map((project) => (
              <article class="project-card">
                <img src={project.image} alt="" loading="lazy" />
                <p class="eyebrow">{project.url}</p>
                <h3>{project.name}</h3>
                <p>{project.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="thoughts" aria-labelledby="thoughts-title">
        <div class="container">
          <h2 class="section-title" id="thoughts-title">Thoughts</h2>
          <div class="thought-list">
            <a class="thought-row" href="/blog/all-kyoto-theme-features/">
              <span>All Kyoto Theme Features</span><i></i><time datetime="2025-02-04">04 Feb</time><span class="row-arrow" set:html={Arrow}></span>
            </a>
            <a class="thought-row" href="/blog/designing-for-quiet-moments/">
              <span>Designing for the Quiet Moments</span><i></i><time datetime="2025-01-18">18 Jan</time><span class="row-arrow" set:html={Arrow}></span>
            </a>
            <a class="thought-row" href="/blog/a-practical-creative-system/">
              <span>A Practical Creative System</span><i></i><time datetime="2024-12-07">07 Dec</time><span class="row-arrow" set:html={Arrow}></span>
            </a>
            <a class="thought-row" href="/blog/what-i-keep-on-my-desk/">
              <span>What I Keep on My Desk</span><i></i><time datetime="2024-11-22">22 Nov</time><span class="row-arrow" set:html={Arrow}></span>
            </a>
          </div>
        </div>
      </section>

      <section class="section" id="works" aria-labelledby="works-title">
        <div class="container">
          <h2 class="section-title" id="works-title">Case studies</h2>
          <div class="studies-grid">
            {studies.map((study) => (
              <article class="study-card">
                <img src={study.image} alt="" loading="lazy" />
                <div>
                  <p>{study.company}</p>
                  <h3>{study.title}</h3>
                </div>
                {study.href && <a href={study.href} aria-label={`Read ${study.company} case study`}></a>}
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="testimonials" aria-labelledby="testimonials-title">
        <div class="container">
          <h2 class="section-title" id="testimonials-title">Testimonials</h2>
          <div class="testimonial-grid">
            {testimonials.map((testimonial) => (
              <figure class="testimonial">
                <blockquote>{testimonial.quote}</blockquote>
                <figcaption>
                  <img src={testimonial.image} alt="" loading="lazy" />
                  <span><strong>{testimonial.name}</strong><small>{testimonial.role}</small></span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="experience" aria-labelledby="experience-title">
        <div class="container">
          <h2 class="section-title" id="experience-title">Work Experiences</h2>
          <div class="experience-list">
            {experiences.map(([role, company, date]) => (
              <div class="experience-row">
                <span><small>{role}</small><strong>{company}</strong></span><i></i><time>{date}</time>
              </div>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer" id="footer">
      <div class="container">
        <div class="wave-divider"></div>
        <div class="footer-links">
          <div><h2>Index</h2><a href="#thoughts">Thoughts</a><a href="#works">Works</a><a href="#now">Now</a><a href="#main">About</a></div>
          <div><h2>Connect</h2><a href="https://github.com/erayack" target="_blank" rel="noopener noreferrer">GitHub</a></div>
        </div>
        <div class="wave-divider"></div>
        <p class="copyright"><a href="https://github.com/erayack" target="_blank" rel="noopener noreferrer">Eray Ack</a> © 2026. Crafted with Astro and thoughtful details.</p>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const themeButtons = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');

      function updateThemeControls() {
        const dark = root.dataset.theme === 'dark';
        themeButtons.forEach((button) => {
          button.setAttribute('aria-pressed', String(dark));
          button.setAttribute('aria-label', dark ? 'Use light mode' : 'Use dark mode');
          if (button.classList.contains('mobile-theme')) button.textContent = dark ? 'Use light mode' : 'Use dark mode';
        });
      }

      themeButtons.forEach((button) => button.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        localStorage.setItem('theme', root.dataset.theme);
        updateThemeControls();
      }));
      updateThemeControls();

      const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const mobileNav = document.querySelector<HTMLElement>('#mobile-nav');
      menuButton?.addEventListener('click', () => {
        const open = menuButton.getAttribute('aria-expanded') !== 'true';
        menuButton.setAttribute('aria-expanded', String(open));
        menuButton.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
        if (mobileNav) mobileNav.hidden = !open;
      });
      mobileNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        if (mobileNav && menuButton) {
          mobileNav.hidden = true;
          menuButton.setAttribute('aria-expanded', 'false');
          menuButton.setAttribute('aria-label', 'Open navigation');
        }
      }));

      const moreButton = document.querySelector<HTMLButtonElement>('.more-button');
      const moreNav = document.querySelector<HTMLElement>('#more-nav');
      moreButton?.addEventListener('click', () => {
        const open = moreButton.getAttribute('aria-expanded') !== 'true';
        moreButton.setAttribute('aria-expanded', String(open));
        if (moreNav) moreNav.hidden = !open;
      });
      moreNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        moreNav.hidden = true;
        moreButton?.setAttribute('aria-expanded', 'false');
      }));
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        if (mobileNav && menuButton) {
          mobileNav.hidden = true;
          menuButton.setAttribute('aria-expanded', 'false');
          menuButton.setAttribute('aria-label', 'Open navigation');
        }
        if (moreNav && moreButton) {
          moreNav.hidden = true;
          moreButton.setAttribute('aria-expanded', 'false');
        }
      });

      document.querySelector<HTMLFormElement>('#newsletter-form')?.addEventListener('submit', (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        const status = document.querySelector<HTMLElement>('.form-status');
        const button = form.querySelector<HTMLButtonElement>('button');
        if (button) {
          button.disabled = true;
          button.textContent = 'Sending…';
        }
        window.setTimeout(() => {
          if (status) status.textContent = 'Email sent. Check your inbox!';
          if (button) {
            button.disabled = false;
            button.textContent = 'Subscribe';
          }
          form.reset();
        }, 650);
      });
    </script>
  </body>
</html>
